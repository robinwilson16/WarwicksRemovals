@page "/Quote"

<PageTitle>Home</PageTitle>

<div class="container-fluid Blue p-5">
    <div class="row">
        <div class="container">
            <div class="row">
                <div class="col-md my-auto">
                    <h4 class="Highlight">
                        Warwicks Removals are a North East family run business which is based in Morpeth and covers the whole of the UK.
                    </h4>
                    <p>
                        Your journey with us starts with a no obligation home survey and quote.
                        Priding ourselves on our professionalism and competitive prices, we can then provide a personal service tailored to your needs.
                    </p>
                </div>
                <div class="col-md">
                    <img src="/images/Vans.png" alt="We have a range of fully equiped vehicles" class="img-fluid" />
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container-fluid p-5">
    <div class="row">
        <div class="container">
            <div class="row">
                <div class="col-md">
                    @* <div id="target"></div> *@
